# ---------------------------------------------------------------------------
# Aurena Nails — example environment file
# Copy to `.env.local` (local development) or configure these keys in
# Netlify → Site configuration → Environment variables (production).
# Never commit real secrets. Values below are placeholders only.
# ---------------------------------------------------------------------------

# PostgreSQL / Neon connection string (use the pooled "PgBouncer" URL on Netlify)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon Auth endpoint.
#   - Hosted Neon Auth project:  https://<endpoint>.neonauth.<region>.aws.neon.tech
#   - Leave EMPTY in production to use the app's built-in Neon Auth-compatible
#     endpoint at /api/neon-auth (the app derives the URL from the request host
#     and creates the neon_auth tables lazily).
NEON_AUTH_BASE_URL=

# 32+ character secret used to sign session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Cloudinary media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: transactional email (password reset)
EMAIL_SERVER=
EMAIL_FROM=Aurena Nails <noreply@aurenanails.com>
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Initial administrator (create or reset)
# ---------------------------------------------------------------------------
# These are read from the environment only — never commit real values.
# Provision/reset with either of:
#
#   node scripts/inspect-production-db.js        # read-only, required first
#   npm run admin:provision -- --check       # read-only account state
#   npm run admin:provision -- --apply       # after target confirmation
#
# Apply is idempotent but writes to the database and requires
# CONFIRM_DATABASE_TARGET=<host>/<database> after a production preflight. See docs/admin-login-runbook.md.
#
# INITIAL_ADMIN_EMAIL=admin@aurenanails.com
# INITIAL_ADMIN_PASSWORD=<set in your shell or Netlify UI, never in Git>
# INITIAL_ADMIN_MOBILE=
# INITIAL_ADMIN_REVOKE_SESSIONS=false

# CONFIRM_DATABASE_TARGET=host/database
